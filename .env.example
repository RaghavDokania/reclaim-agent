SUPABASE_URL=your-project-url-here
SUPABASE_KEY=your-anon-or-service-key-here
RAZORPAY_KEY_ID=your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret
GROQ_API_KEY=your-groq-api-key
# Only needed to run the webhook listener (ingest/server.py). Razorpay
# shows this when you create the webhook; the server refuses to start
# without it rather than accepting unsigned requests.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
